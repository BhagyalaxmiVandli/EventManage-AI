
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EventAI - Smart Event Management</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', sans-serif;
    scroll-behavior: smooth;
}

body {
    background: #0d0b1b;
    color: white;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 8%;
    background: #151229;
    position: sticky;
    top: 0;
    z-index: 10;
}

.logo {
    font-size: 27px;
    font-weight: bold;
    color: #b69aff;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 12px;
    font-size: 15px;
}

nav a:hover {
    color: #b69aff;
}

.btn {
    background: linear-gradient(90deg,#8c52ff,#c084fc);
    padding: 12px 22px;
    color: white;
    border: none;
    border-radius: 25px;
    cursor: pointer;
    font-weight: bold;
}

.hero {
    min-height: 570px;
    padding: 110px 8%;
    background:
    linear-gradient(90deg,rgba(13,11,27,.98),rgba(13,11,27,.65)),
    url('https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=1600');
    background-size: cover;
    background-position: center;
}

.hero h1 {
    font-size: 55px;
    max-width: 650px;
    line-height: 1.2;
}

.hero h1 span {
    color: #bb91ff;
}

.hero p {
    margin: 22px 0;
    color: #d0cce0;
    font-size: 18px;
    max-width: 550px;
    line-height: 1.6;
}

section {
    padding: 75px 8%;
}

.section-title {
    text-align: center;
    font-size: 34px;
    margin-bottom: 15px;
}

.subtitle {
    text-align: center;
    color: #aaa4c0;
    margin-bottom: 40px;
}

.ai-box {
    background: linear-gradient(135deg,#21183e,#34205d);
    padding: 35px;
    border-radius: 20px;
    max-width: 850px;
    margin: auto;
    text-align: center;
    border: 1px solid #624394;
}

.ai-box h2 {
    color: #c6a5ff;
    margin-bottom: 15px;
}

input, select, textarea {
    padding: 14px;
    border-radius: 10px;
    border: 1px solid #51476d;
    background: #17132b;
    color: white;
    width: 100%;
    margin: 10px 0;
    outline: none;
}

.ai-box button {
    margin-top: 12px;
}

#aiResult {
    margin-top: 20px;
    color: #d9c6ff;
    line-height: 1.7;
}

.event-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(240px,1fr));
    gap: 25px;
}

.event-card {
    background: #19162d;
    border-radius: 16px;
    overflow: hidden;
    transition: .3s;
    border: 1px solid #302747;
}

.event-card:hover {
    transform: translateY(-8px);
    border-color: #a77bff;
}

.event-card img {
    width: 100%;
    height: 190px;
    object-fit: cover;
}

.event-info {
    padding: 20px;
}

.event-info h3 {
    margin-bottom: 10px;
}

.event-info p {
    color: #b9b3cc;
    margin: 8px 0;
}

.event-info button {
    margin-top: 12px;
}

.features {
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(200px,1fr));
    gap: 20px;
}

.feature {
    background: #19162d;
    padding: 30px 20px;
    border-radius: 15px;
    text-align: center;
    border: 1px solid #302747;
}

.feature h3 {
    color: #c5a1ff;
    margin: 15px 0;
}

.feature .emoji {
    font-size: 38px;
}

.contact {
    max-width: 650px;
    margin: auto;
    text-align: center;
}

footer {
    background: #151229;
    text-align: center;
    padding: 25px;
    color: #aaa4c0;
}

@media(max-width:700px) {
    header {
        flex-direction: column;
        gap: 15px;
    }
    nav a {
        margin: 5px;
        font-size: 13px;
    }
    .hero h1 {
        font-size: 38px;
    }
    .hero {
        padding: 85px 7%;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">✦ EventAI</div>
    <nav>
        <a href="#home">Home</a>
        <a href="#ai">AI Planner</a>
        <a href="#events">Events</a>
        <a href="#features">Features</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<div class="hero" id="home">
    <h1>Plan Your Events <span>Smarter</span> With AI</h1>
    <p>
        Discover amazing events, organize unforgettable experiences
        and let Artificial Intelligence make your event planning easier.
    </p>
    <a href="#events">
        <button class="btn">Explore Events →</button>
    </a>
    <a href="#ai">
        <button class="btn">Try AI Planner ✨</button>
    </a>
</div>

<section id="ai">
    <h2 class="section-title">✨ AI Event Planner</h2>
    <p class="subtitle">Tell us your requirements. Get a smart event idea!</p>

    <div class="ai-box">
        <h2>Let AI Plan Your Perfect Event</h2>

        <input id="eventType" placeholder="Event type (Birthday, Wedding, College...)">

        <input id="budget" type="number" placeholder="Your budget (₹)">

        <input id="people" type="number" placeholder="Number of guests">

        <button class="btn" onclick="generatePlan()">
            Generate Event Plan ✨
        </button>

        <div id="aiResult"></div>
    </div>
</section>

<section id="events">
    <h2 class="section-title">Upcoming Events</h2>
    <p class="subtitle">Find events that match your interests.</p>

    <input id="search" placeholder="🔍 Search events..." oninput="searchEvents()">

    <div class="event-grid" id="eventGrid">

        <div class="event-card">
            <img src="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=700">
            <div class="event-info">
                <h3>Music Festival</h3>
                <p>📍 Bengaluru</p>
                <p>🎵 Music & Entertainment</p>
                <p>₹499 onwards</p>
                <button class="btn" onclick="bookEvent('Music Festival')">Book Now</button>
            </div>
        </div>

        <div class="event-card">
            <img src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=700">
            <div class="event-info">
                <h3>Wedding Celebration</h3>
                <p>📍 Mysuru</p>
                <p>💍 Wedding Event</p>
                <p>₹999 onwards</p>
                <button class="btn" onclick="bookEvent('Wedding Celebration')">Book Now</button>
            </div>
        </div>

        <div class="event-card">
            <img src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=700">
            <div class="event-info">
                <h3>Tech Conference</h3>
                <p>📍 Bengaluru</p>
                <p>💻 Technology</p>
                <p>₹299 onwards</p>
                <button class="btn" onclick="bookEvent('Tech Conference')">Book Now</button>
            </div>
        </div>

        <div class="event-card">
            <img src="https://images.unsplash.com/photo-1519671482749-fd09be7ccebf?w=700">
            <div class="event-info">
                <h3>Birthday Party</h3>
                <p>📍 Hubballi</p>
                <p>🎂 Celebration</p>
                <p>₹199 onwards</p>
                <button class="btn" onclick="bookEvent('Birthday Party')">Book Now</button>
            </div>
        </div>

    </div>
</section>

<section id="features">
    <h2 class="section-title">Why Choose EventAI?</h2>
    <p class="subtitle">Everything you need to organize successful events.</p>

    <div class="features">
        <div class="feature">
            <div class="emoji">🤖</div>
            <h3>AI Planning</h3>
            <p>Generate event ideas and planning suggestions.</p>
        </div>

        <div class="feature">
            <div class="emoji">🎟️</div>
            <h3>Easy Booking</h3>
            <p>Book your favourite events easily.</p>
        </div>

        <div class="feature">
            <div class="emoji">💰</div>
            <h3>Budget Planning</h3>
            <p>Get suggestions according to your budget.</p>
        </div>

        <div class="feature">
            <div class="emoji">📅</div>
            <h3>Smart Scheduling</h3>
            <p>Organize your events and activities.</p>
        </div>
    </div>
</section>

<section id="contact">
    <h2 class="section-title">Contact Us</h2>
    <p class="subtitle">Have questions? Send us a message.</p>

    <div class="contact">
        <input placeholder="Your Name" id="name">
        <input placeholder="Your Email" id="email">
        <textarea placeholder="Your Message" id="message" rows="4"></textarea>
        <button class="btn" onclick="sendMessage()">Send Message</button>
    </div>
</section>

<footer>
    <h3>✦ EventAI</h3>
    <p>Making Every Event Special With Smart Technology.</p>
    <p>© 2026 EventAI. All Rights Reserved.</p>
</footer>

<script>

function generatePlan() {
    let type = document.getElementById("eventType").value;
    let budget = Number(document.getElementById("budget").value);
    let people = Number(document.getElementById("people").value);
    let result = document.getElementById("aiResult");

    if(!type || budget <= 0 || people <= 0) {
        result.innerHTML = "Please enter all details correctly.";
        return;
    }

    let food = budget * 0.35;
    let decoration = budget * 0.20;
    let venue = budget * 0.30;
    let other = budget * 0.15;

    result.innerHTML = `
        <h3>✨ Your ${type} Plan</h3>
        <p>👥 Guests: ${people}</p>
        <p>💰 Total Budget: ₹${budget}</p>
        <p>🍽️ Food: ₹${food.toFixed(0)}</p>
        <p>🎨 Decoration: ₹${decoration.toFixed(0)}</p>
        <p>🏛️ Venue: ₹${venue.toFixed(0)}</p>
        <p>✨ Other Expenses: ₹${other.toFixed(0)}</p>
        <p>Your personalized event plan is ready!</p>
    `;
}

function searchEvents() {
    let value = document.getElementById("search").value.toLowerCase();
    let cards = document.querySelectorAll(".event-card");

    cards.forEach(card => {
        card.style.display =
        card.innerText.toLowerCase().includes(value) ? "" : "none";
    });
}

function bookEvent(name) {
    alert("You selected " + name + "! Booking functionality can be connected next.");
}

function sendMessage() {
    let name = document.getElementById("name").value;
    let email = document.getElementById("email").value;
    let message = document.getElementById("message").value;

    if(!name || !email || !message) {
        alert("Please fill all the fields.");
        return;
    }

    alert("Thank you " + name + "! Your message has been noted.");
}

</script>

</body>
</html>
